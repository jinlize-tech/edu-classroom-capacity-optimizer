              "OUT_OF_SCOPE",
              "SENSITIVE_DATA",
              "EVIDENCE_UNVERIFIED",
              "TOOL_UNAVAILABLE",
              "HUMAN_REVIEW_REQUIRED",
              "CALCULATION_FAILED",
              "INDEPENDENCE_VIOLATION",
